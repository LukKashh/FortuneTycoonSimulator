rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint for health check
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // Hardened global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAuthorizedAdminEmail() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && (
          request.auth.token.email == "puncisters@gmail.com"
          || request.auth.token.email == "lukass16.ivanovs@gmail.com"
          || request.auth.token.email == "lukass21.ivanovs@gmail.com"
          || request.auth.token.email.matches('(?i)^(puncisters@gmail\\.com|lukass16\\.ivanovs@gmail\\.com|lukass21\\.ivanovs@gmail\\.com)$')
        );
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || isAuthorizedAdminEmail()
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlayerState(data) {
      return data.keys().hasAll(['userId', 'username', 'version', 'state'])
        && data.userId is string && data.userId.size() <= 128
        && data.username is string && data.username.size() <= 32
        && data.version is number
        && data.state is map;
    }

    function isValidCorporation(data) {
      return data.keys().hasAll(['id', 'name', 'tag', 'founderId', 'version', 'state'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 48
        && data.tag is string && data.tag.size() <= 8
        && data.founderId is string && data.founderId.size() <= 128
        && data.version is number
        && data.state is map;
    }

    function isValidLedger(data) {
      return data.keys().hasAll(['id', 'type', 'source', 'destination', 'amount'])
        && data.id is string && data.id.size() <= 128
        && data.type is string && data.type.size() <= 64
        && data.source is string && data.source.size() <= 128
        && data.destination is string && data.destination.size() <= 128
        && data.amount is number;
    }

    function isValidCollectibleStock(data) {
      return data.keys().hasAll(['itemId', 'sold'])
        && data.itemId is string && data.itemId.size() <= 64
        && data.sold is number;
    }

    function isValidUsername(data) {
      return data.keys().hasAll(['username', 'userId'])
        && data.username is string && data.username.size() <= 32
        && data.userId is string && data.userId.size() <= 128;
    }

    // Admin collection: readable by signed-in users, writable by admins or authorized admin email bootstrapping their record
    match /admins/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() || (isAuthorizedAdminEmail() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Player state collection (cloud-saved game per player)
    match /player_states/{userId} {
      // Full saves contain private progression, balances, holdings and history.
      // Ordinary clients may read only their own save; administrators retain access.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) || isAdmin())
        && isValidPlayerState(incoming())
        && incoming().userId == userId;
      allow update: if (
          (
            isOwner(userId)
            && (!('userId' in existing()) || existing().userId == userId)
            && (
              !('username' in existing())
              || existing().username == incoming().username
              || existing().username == "GuestTycoon"
              || existing().username == "Player"
            )
          )
          || isAdmin()
        )
        && isValidPlayerState(incoming())
        && incoming().userId == userId;
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Minimal public leaderboard projection; never expose the private save payload.
    match /public_players/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isOwner(userId) || isAdmin())
        && incoming().userId == userId
        && incoming().username is string && incoming().username.size() <= 32
        && (!('title' in incoming()) || (incoming().title is string && incoming().title.size() <= 40))
        && (!('avatar' in incoming()) || (incoming().avatar is string && incoming().avatar.size() <= 32))
        && (!('bio' in incoming()) || (incoming().bio is string && incoming().bio.size() <= 100));
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Lightweight public ranking data maintained atomically with corporation saves.
    match /public_corporations/{corpId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn()
        && incoming().id == corpId;
      allow delete: if isSignedIn() || isAdmin();
    }

    // Administrator adjustment audit trail (append-only for admins)
    match /admin_audit/{entryId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && incoming().keys().hasAll([
          'actorUid', 'actorEmail', 'targetUid', 'targetUsername',
          'operation', 'enteredAmount', 'previousValue', 'resultingValue',
          'previousLevel', 'resultingLevel', 'createdAt'
        ])
        && incoming().actorUid == request.auth.uid
        && (incoming().actorEmail == null || incoming().actorEmail is string)
        && incoming().targetUid is string
        && incoming().targetUsername is string
        && incoming().operation in [
          'set-balance', 'add-balance', 'subtract-balance', 'grant-xp', 'set-xp', 'set-level', 'wipe-database'
        ]
        && incoming().enteredAmount is number
        && incoming().previousValue is number
        && incoming().resultingValue is number
        && incoming().previousLevel is number
        && incoming().resultingLevel is number
        && incoming().createdAt is number;
      allow update, delete: if isAdmin();
    }

    // Online player corporations
    match /corporations/{corpId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidCorporation(incoming())
        && incoming().founderId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidCorporation(incoming())
        && (
          isAdmin()
          || existing().founderId == request.auth.uid
          || (existing().members != null && existing().members[request.auth.uid] != null)
          || (incoming().applications != null && incoming().applications[request.auth.uid] != null)
          || (existing().applications != null && existing().applications[request.auth.uid] != null)
          || (existing().invites != null && existing().invites[request.auth.uid] != null)
        );
      allow delete: if isAdmin();
    }

    // Ledger transactions (append-only)
    match /ledger/{ledgerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidLedger(incoming());
      allow update, delete: if isAdmin();
    }

    // Limited edition collectible stock counters
    match /collectible_stock/{itemId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidCollectibleStock(incoming());
      allow delete: if isAdmin();
    }

    // Unique username registry
    match /usernames/{usernameLower} {
      allow get, list: if isSignedIn();
      allow create: if (
          isSignedIn()
          && isValidUsername(incoming())
          && incoming().userId == request.auth.uid
        )
        || isAdmin();
      allow update: if (
          (
            isSignedIn()
            && isValidUsername(incoming())
            && incoming().userId == request.auth.uid
            && (
              !('userId' in existing())
              || existing().userId == request.auth.uid
              || !exists(/databases/$(database)/documents/player_states/$(existing().userId))
            )
          )
          || isAdmin()
        );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }
  }
}
