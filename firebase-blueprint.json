{
  "entities": {
    "PlayerState": {
      "title": "PlayerState",
      "description": "User game state and profile data",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user ID matching auth UID",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Player in-game display name",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_ -]+$"
        },
        "version": {
          "type": "number",
          "description": "Optimistic concurrency lock version"
        },
        "netWorth": {
          "type": "number",
          "description": "Calculated total player net worth"
        },
        "level": {
          "type": "number",
          "description": "Current player tycoon level"
        },
        "state": {
          "type": "object",
          "description": "Authoritative game state payload"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of last action in milliseconds"
        }
      },
      "required": [
        "userId",
        "username",
        "version",
        "state"
      ]
    },
    "Corporation": {
      "title": "Corporation",
      "description": "Online cooperative player corporation document",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique corporation identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Corporation name",
          "maxLength": 48
        },
        "tag": {
          "type": "string",
          "description": "Short ticker tag",
          "maxLength": 8
        },
        "founderId": {
          "type": "string",
          "description": "UID of founder player",
          "maxLength": 128
        },
        "version": {
          "type": "number",
          "description": "Concurrency version counter"
        },
        "state": {
          "type": "object",
          "description": "Corporation full state payload"
        },
        "dissolved": {
          "type": "boolean",
          "description": "Whether the corporation has been dissolved"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "id",
        "name",
        "tag",
        "founderId",
        "version",
        "state"
      ]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Immutable transaction or activity log entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log identifier",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Transaction category",
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "description": "Origin entity or player ID",
          "maxLength": 128
        },
        "destination": {
          "type": "string",
          "description": "Target entity or treasury",
          "maxLength": 128
        },
        "amount": {
          "type": "number",
          "description": "Monetary value transferred"
        },
        "entity": {
          "type": "string",
          "description": "Associated item or business name",
          "maxLength": 128
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp entry was recorded"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "destination",
        "amount"
      ]
    },
    "CollectibleStock": {
      "title": "CollectibleStock",
      "description": "Global inventory count for limited-edition items",
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "description": "Item definition identifier",
          "maxLength": 64
        },
        "sold": {
          "type": "number",
          "description": "Units sold globally"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last stock purchase timestamp"
        }
      },
      "required": [
        "itemId",
        "sold"
      ]
    },
    "UsernameRecord": {
      "title": "UsernameRecord",
      "description": "Unique username registry index",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Lowercase normalized username",
          "maxLength": 32
        },
        "userId": {
          "type": "string",
          "description": "Player UID that owns this username",
          "maxLength": 128
        },
        "createdAt": {
          "type": "number",
          "description": "Registration timestamp"
        }
      },
      "required": [
        "username",
        "userId"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Designated administrator identity record",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the administrator",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Administrator email address",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Administrator role name",
          "maxLength": 32
        },
        "grantedAt": {
          "type": "number",
          "description": "Timestamp when admin role was granted"
        }
      },
      "required": [
        "userId"
      ]
    },
    "AdminAudit": {
      "title": "AdminAudit",
      "description": "Append-only administrator action audit trail",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "description": "UID of administrator taking action",
          "maxLength": 128
        },
        "actorEmail": {
          "type": "string",
          "description": "Email of administrator taking action",
          "maxLength": 128
        },
        "targetUid": {
          "type": "string",
          "description": "Target player UID",
          "maxLength": 128
        },
        "targetUsername": {
          "type": "string",
          "description": "Target player username",
          "maxLength": 32
        },
        "operation": {
          "type": "string",
          "description": "Operation type (set-balance, add-balance, subtract-balance, grant-xp, set-xp, set-level, wipe-database)",
          "maxLength": 32
        },
        "enteredAmount": {
          "type": "number",
          "description": "Numeric adjustment entered"
        },
        "previousValue": {
          "type": "number",
          "description": "Pre-adjustment value"
        },
        "resultingValue": {
          "type": "number",
          "description": "Post-adjustment value"
        },
        "previousLevel": {
          "type": "number",
          "description": "Pre-adjustment level"
        },
        "resultingLevel": {
          "type": "number",
          "description": "Post-adjustment level"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp in milliseconds"
        }
      },
      "required": [
        "actorUid",
        "targetUid",
        "targetUsername",
        "operation",
        "enteredAmount",
        "previousValue",
        "resultingValue",
        "previousLevel",
        "resultingLevel",
        "createdAt"
      ]
    },
    "PublicPlayer": {
      "title": "PublicPlayer",
      "description": "Minimal public ranking projection; excludes private player save data",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "maxLength": 32
        },
        "level": {
          "type": "number"
        },
        "netWorth": {
          "type": "number"
        },
        "corpTag": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8
        },
        "corpId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": [
        "userId",
        "username",
        "level",
        "netWorth",
        "corpTag",
        "corpId",
        "updatedAt"
      ]
    },
    "PublicCorporation": {
      "title": "PublicCorporation",
      "description": "Lightweight public ranking projection, maintained with corporation saves",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 48
        },
        "tag": {
          "type": "string",
          "maxLength": 8
        },
        "level": {
          "type": "number"
        },
        "xp": {
          "type": "number"
        },
        "activity": {
          "type": "number"
        },
        "valuation": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "tag",
        "level",
        "xp",
        "activity",
        "valuation"
      ]
    }
  },
  "firestore": {
    "/player_states/{userId}": {
      "schema": "PlayerState",
      "description": "Stores user cloud saved game state"
    },
    "/corporations/{corpId}": {
      "schema": "Corporation",
      "description": "Stores online player corporations"
    },
    "/ledger/{ledgerId}": {
      "schema": "LedgerEntry",
      "description": "Stores global and corp transaction logs"
    },
    "/collectible_stock/{itemId}": {
      "schema": "CollectibleStock",
      "description": "Tracks limited collectible supplies across players"
    },
    "/usernames/{usernameLower}": {
      "schema": "UsernameRecord",
      "description": "Unique username reservation index"
    },
    "/admins/{userId}": {
      "schema": "AdminRecord",
      "description": "Authorized administrator records for role-based authorization"
    },
    "/admin_audit/{entryId}": {
      "schema": "AdminAudit",
      "description": "Audit trail entries for administrative data adjustments"
    },
    "/public_players/{userId}": {
      "schema": "PublicPlayer",
      "description": "Minimal public leaderboard data; excludes private player saves"
    },
    "/public_corporations/{corpId}": {
      "schema": "PublicCorporation",
      "description": "Lightweight public corporation leaderboard projection"
    }
  }
}
